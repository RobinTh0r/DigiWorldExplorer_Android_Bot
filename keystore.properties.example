# Vorlage fuer die lokale Signierung des Release-Builds.
# 1. Kopiere diese Datei zu "keystore.properties" (liegt neben settings.gradle.kts).
# 2. Erzeuge einmalig einen eigenen Keystore, z. B.:
#    & "$env:JAVA_HOME\bin\keytool.exe" -genkeypair -v -keystore digiworldexplorer-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias digiworldexplorer
# 3. Trage unten die bei der Erzeugung gewaehlten Werte ein.
#
# "keystore.properties" und alle *.jks/*.keystore-Dateien sind in .gitignore eingetragen
# und werden nie eingecheckt oder hochgeladen.

storeFile=../digiworldexplorer-release.jks
storePassword=
keyAlias=digiworldexplorer
keyPassword=
